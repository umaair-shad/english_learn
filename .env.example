# ----- Vocabulary pipeline configuration -------------------------------

# Root of all pipeline data (staging/processed/reports/exports).
# Defaults to <repo>/data when unset.
DATA_ROOT=

# Directory containing the raw client datasets. Overrides DATA_ROOT/raw.
# Example (Windows): E:\fiver\Project English Learn\project
RAW_DATASET_DIR=

# Production PostgreSQL connection string.
# Example: postgresql://vocab:vocab@localhost:5432/vocabulary
DATABASE_URL=postgresql://vocab:vocab@localhost:5432/vocabulary

# Development sampling: process only the first N English Wiktextract records.
# Leave empty/unset to process the COMPLETE English dataset.
# PIPELINE_LIMIT=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Minimum gloss similarity (0-100) before a sense→synset match is kept.
MIN_GLOSS_SIMILARITY=58